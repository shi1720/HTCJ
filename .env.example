# Copy to .env; load with your process manager or node --env-file=.env.
# Development defaults: API 3001; Vite 5173; data persists in ./data.
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./data/groundproof.sqlite
# Required in production. Deploy behind an HTTPS reverse proxy.
PUBLIC_ORIGIN=https://your-groundproof-domain.example
# Optional. Never put this value in a VITE_ variable or commit it.
ANAKIN_API_KEY=
# Anakin captures use the official API endpoint; see docs/ANAKIN.md.

# Shared supplier-call budget; demo workspaces additionally have 3 calls/UTC day.
ANAKIN_DAILY_LIMIT=30
