{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groundproof",
  "main": "workers/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "workers_dev": true,
  "vars": { "PUBLIC_ORIGIN": "https://groundproof.groundproof.workers.dev", "ANAKIN_DAILY_LIMIT": "30" },
  "alias": { "better-sqlite3": "./workers/sqlite-stub.ts" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "GROUNDPROOF", "class_name": "GroundProofDatabase" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GroundProofDatabase"] }],
  "observability": { "enabled": false }
}
