{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["./env.d.ts", "node"]
  },
  "include": ["./*.ts", "../server/**/*.ts", "../shared/**/*.ts"],
  "exclude": ["./*.test.ts", "./vitest.config.ts"]
}
